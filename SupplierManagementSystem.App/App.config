<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Must match the schema you open in MySQL Workbench / phpMyAdmin (default: database on localhost:3306). -->
    <add name="MysqlServer"
         connectionString="Server=localhost;Port=3306;Uid=root;Pwd=;"
         providerName="MySql.Data.MySqlClient" />
    <add name="MysqlApp"
         connectionString="Server=localhost;Port=3306;Database=database;Uid=root;Pwd=;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- When true, startup runs optional extra demo INSERTs once per launch (idempotent). Default false keeps DB stable. -->
    <add key="RunExtraDemoSeedOnStartup" value="false" />
  </appSettings>
</configuration>
